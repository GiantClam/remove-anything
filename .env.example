# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Remote image imports also trust HTTPS R2_URL_BASE/NEXT_PUBLIC_APP_URL/NEXTAUTH_URL origins.
# Comma-separated extra operator-controlled HTTPS origins; arbitrary URLs must be uploaded.
IMAGE_INPUT_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx

# -----------------------------------------------------------------------------
# Database (MySQL - Neon DB)

# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL=xxx
# Direct connection to the database. Used for migrations.
DIRECT_URL=xxx
        

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=xxx

# -----------------------------------------------------------------------------
# Subscriptions (Stripe)
# -----------------------------------------------------------------------------
STRIPE_API_KEY=xxx
STRIPE_WEBHOOK_SECRET=xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_ENV=sandbox

NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PLAN_ID=xxx
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PLAN_ID=xxx

NEXT_PUBLIC_STRIPE_BUSINESS_MONTHLY_PLAN_ID=xxx
NEXT_PUBLIC_STRIPE_BUSINESS_YEARLY_PLAN_ID=xxx

S3_ENDPOINT=xxx
S3_REGION=auto
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_URL_BASE=xxx
S3_BUCKET=xxx

# Keep a separate R2 bucket for background-composition results. Do not enable
# r2.dev or attach a public custom domain to this bucket.
R2_PRIVATE_BUCKET=

SITE_NOTIFICATION_EMAIL_TO=xxx
NEXT_PUBLIC_SITE_EMAIL_FROM=xxx
NEXT_PUBLIC_SITE_URL=xxx

# Upstash Redis 必需
UPSTASH_REDIS_REST_URL=xxx
UPSTASH_REDIS_REST_TOKEN=xxx

HASHID_SALT=xxx

# Clerk 登录必需
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=xxx
CLERK_SECRET_KEY=xxx
WEBHOOK_SECRET=xxx

LOG_SNAG_TOKEN=xxx

TASK_HEADER_KEY=xxx

# Cron authentication and task file retention (dry-run until explicitly enabled)
CRON_SECRET=
TASK_RETENTION_EXECUTE=false
TASK_RETENTION_BATCH_SIZE=100

FLUX_HEADER_KEY=xxx

FLUX_CREATE_URL=xxx

APP_ENV=development

# NEXT_PUBLIC_UMAMI_DATA_ID=xxx
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_CLARITY_ID=xxx

SENTRY_DSN=xxx

# -----------------------------------------------------------------------------
# RunningHub remove objects
# -----------------------------------------------------------------------------
RUNNINGHUB_API_BASE_URL=xxx

# Replicate webhook verification. Set the output prefix from an existing result;
# an empty value keeps successful callbacks fail-closed until approved.
REPLICATE_WEBHOOK_SECRET=
REPLICATE_OUTPUT_URL_PREFIXES=

# Replicate webhook verification and explicitly approved result prefixes.
REPLICATE_WEBHOOK_SECRET=
REPLICATE_OUTPUT_URL_PREFIXES=https://replicate.delivery/pbxt/
RUNNINGHUB_API_KEY=xxx
# Optional authenticated callbacks. Leave blank to use task polling.
# Use a random secret of at least 32 characters. Never expose or log it.
RUNNINGHUB_WEBHOOK_SECRET=
# Comma-separated, verified HTTPS provider output origin/path prefixes.
# Example syntax only: https://outputs.example.com/approved-output-path/
RUNNINGHUB_OUTPUT_URL_PREFIXES=
RUNNINGHUB_OBJECT_DETECT_WORKFLOW_ID=xxx
RUNNINGHUB_OBJECT_REMOVE_WORKFLOW_ID=2063827026330607618
RUNNINGHUB_OBJECT_SEGMENT_WORKFLOW_ID=2062736566451269633
RUNNINGHUB_OBJECT_DETECT_IMAGE_NODE_ID=image
RUNNINGHUB_OBJECT_DETECT_IMAGE_FIELD_NAME=image
RUNNINGHUB_OBJECT_DETECT_PROMPT_NODE_ID=prompt
RUNNINGHUB_OBJECT_DETECT_PROMPT_FIELD_NAME=prompt
RUNNINGHUB_OBJECT_SEGMENT_IMAGE_NODE_ID=19
RUNNINGHUB_OBJECT_SEGMENT_IMAGE_FIELD_NAME=image
RUNNINGHUB_OBJECT_SEGMENT_FRAME_EDITOR_NODE_ID=25
RUNNINGHUB_OBJECT_SEGMENT_FRAME_EDITOR_FIELD_NAME=info
RUNNINGHUB_OBJECT_REMOVE_IMAGE_NODE_ID=94
RUNNINGHUB_OBJECT_REMOVE_IMAGE_FIELD_NAME=image
RUNNINGHUB_OBJECT_REMOVE_MASK_NODE_ID=103
RUNNINGHUB_OBJECT_REMOVE_MASK_FIELD_NAME=image
RUNNINGHUB_OBJECT_REMOVE_PROMPT_NODE_ID=6
RUNNINGHUB_OBJECT_REMOVE_PROMPT_FIELD_NAME=text
